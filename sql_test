CREATE TABLE IF NOT EXISTS favourite_vehicles (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER REFERENCES users(id) NOT NULL ON DELETE CASCADE,
    vehicle_id INTEGER REFERENCES bt_vehicles(id) NOT NULL ON DELETE CASCADE,
    added_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS favourite_routes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER REFERENCES users(id) NOT NULL ON DELETE CASCADE,
    route_id TEXT REFERENCES tx_lines(tx_Id) NOT NULL ON DELETE CASCADE,
    added_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS favourite_operators (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER REFERENCES users(id) NOT NULL ON DELETE CASCADE,
    operator_id TEXT REFERENCES tx_operators(id) NOT NULL ON DELETE CASCADE,
    added_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS bus_photo_details (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    matched_vehicle_id INTEGER REFERENCES bt_vehicles(id),
    override_match INTEGER DEFAULT 0 NOT NULL, -- Whether or not to prefer this details over matched ones
    reg TEXT,
    fleet TEXT,
    livery_id INTEGER REFERENCES bt_liveries(id),
    vehicle_type_id INTEGER REFERENCES bt_vehicle_types(id)
);

CREATE TABLE IF NOT EXISTS photos (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    author_id INTEGER REFERENCES users(id) NOT NULL,
    photo_type INTEGER NOT NULL, -- 0 = Bus Photo, 1 = Model Bus Photo, 2 = Train Photo, etc.
    obj_details_id INTEGER, -- If photo_type is 0 use bus_photo_details
    comment_thread INTEGER REFERENCES comment_threads(id),
    title TEXT NOT NULL,
    description TEXT,
    created_at TEXT NOT NULL
);

-- Each object will reference one of these
CREATE TABLE IF NOT EXISTS comment_threads (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    context TEXT NOT NULL,
    created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS comments (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    thread INTEGER REFERENCES comment_threads(id) NOT NULL ON DELETE CASCADE,
    author_id INTEGER REFERENCES users(id) NOT NULL ON DELETE CASCADE,
    body TEXT NOT NULL,
    edited INTEGER DEFAULT 0 NOT NULL,
    edited_at TEXT,
    parent_comment_id INTEGER REFERENCES comments(id) ON DELETE CASCADE,
    created_at TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS comment_reactions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER REFERENCES users(id) NOT NULL ON DELETE CASCADE,
    comment_id INTEGER REFERENCES comments(id) NOT NULL ON DELETE CASCADE,
    reaction_type INTEGER NOT NULL, -- 0 = Dislike, 1 = Like, etc.
    created_at TEXT NOT NULL,

    UNIQUE (user_id, comment_id)
);



CREATE TABLE IF NOT EXISTS route_checklists (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    owner_id INTEGER REFERENCES users(id) NOT NULL,
    created_at TEXT NOT NULL,
);

CREATE TABLE IF NOT EXISTS route_checklist_items (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    checklist_id INTEGER REFERENCES route_checklists(id) NOT NULL,
    line_id TEXT REFERENCES tx_lines(tx_id) NOT NULL,
    added_at TEXT NOT NULL,
    completed_at TEXT,

    UNIQUE(checklist_id, line_id)
);